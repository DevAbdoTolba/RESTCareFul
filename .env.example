# Copy this file to .env. The .env file is gitignored — never commit secrets.
# Anything not set here falls back to the dev defaults in config/settings/base.py.

# --- Django ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-change-me
DEBUG=True
# Comma-separated. Use * in dev only.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Default = SQLite at ./db.sqlite3 (no install required). Switch to Postgres with:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=sqlite:///db.sqlite3

# --- CORS (React dev server) ---
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PayPal (sandbox) ---
# Server-side REST checkout (payments slice). Leave CLIENT_ID/SECRET blank to run
# the offline DEMO flow (no real PayPal call) — handy for CI and credential-less dev.
# Get sandbox creds at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# Dev-only escape hatch: force a successful capture when the sandbox account
# keeps returning COMPLIANCE_VIOLATION. NEVER set this in production.
PAYPAL_FAKE_CAPTURE=0

# --- Email (Gmail SMTP) ---
# Sender Gmail + a 16-char app password (https://myaccount.google.com/apppasswords).
# Spaces in the password are stripped automatically. Leave the password blank to
# fall back to the console backend (emails print to the terminal, never sent).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
